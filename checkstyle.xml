<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Práctica 2, 3.4 (20 pts): Checkstyle + convención Java 25.
     Configuración propia del proyecto, no google_checks.xml:
     Google exigiría Javadoc en cada método público y líneas de 100
     caracteres, y este código no cumple eso. Nota: LeftCurly (opción
     eol) no admite métodos de una sola línea como
     `public Long getId() { return id; }`; por eso todo método va
     en varias líneas (corregido 2026-11-25, 31 errores de ese tipo).
     No se incluye el modulo Indentation: los encadenamientos
     (MockMvc, streams) lo hacen impredecible y aqui no se pudo
     correr Checkstyle para verificarlo; la indentacion se reviso
     a mano (4 espacios, sin tabs). Si luego se
     agregan rasgos de Java 25 (records, module imports), el
     Checkstyle 9.3 que trae el plugin 3.6.0 podría no parsearlos:
     en ese caso se sube la dependencia de Checkstyle (ver borrador). -->
<module name="Checker">
    <module name="FileTabCharacter"/>
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^(package|import) .*"/>
    </module>
    <module name="TreeWalker">
        <module name="UnusedImports"/>
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="PackageName"/>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="WhitespaceAround"/>
        <module name="WhitespaceAfter"/>
    </module>
</module>
